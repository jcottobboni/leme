{
  "name": "leme",
  "version": "0.8.1",
  "private": true,
  "description": "Agentless desktop client for Kubernetes and OpenShift",
  "main": "main/main.cjs",
  "license": "Apache-2.0",
  "scripts": {
    "dev:ui": "vite",
    "build:ui": "vite build",
    "typecheck": "tsc --noEmit -p .",
    "start": "electron --no-sandbox --ozone-platform-hint=auto .",
    "test:e2e": "playwright test",
    "dist": "node ../scripts/go-licenses.mjs ../engine/bin/leme ../engine/bin/THIRD_PARTY_LICENSES.txt && electron-builder --linux AppImage deb"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@playwright/test": "^1.64.1",
    "@tanstack/react-virtual": "^3.14.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.0",
    "dockview-react": "^8.6.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "elkjs": "^0.12.0",
    "lucide-react": "1.61.0",
    "monaco-editor": "^0.57.0",
    "pixi.js": "8.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "uplot": "^1.6.32",
    "vite": "^8.3.5",
    "zustand": "^5.0.16"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  },
  "author": {
    "name": "João Carlos Ottobboni",
    "email": "jcottobboni@gmail.com"
  },
  "homepage": "https://github.com/jcottobboni/leme",
  "repository": {
    "type": "git",
    "url": "https://github.com/jcottobboni/leme.git"
  },
  "bugs": "https://github.com/jcottobboni/leme/issues",
  "build": {
    "appId": "io.github.jcottobboni.leme",
    "productName": "Leme",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "renderer-dist",
        "to": "renderer-dist"
      },
      {
        "from": "../LICENSE",
        "to": "licenses/LICENSE"
      },
      {
        "from": "../NOTICE",
        "to": "licenses/NOTICE"
      },
      {
        "from": "../THIRD_PARTY_NOTICES.md",
        "to": "licenses/THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "../engine/bin/THIRD_PARTY_LICENSES.txt",
        "to": "licenses/THIRD_PARTY_LICENSES-engine.txt"
      }
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "executableName": "leme",
      "maintainer": "João Carlos Ottobboni <jcottobboni@gmail.com>",
      "synopsis": "Agentless desktop client for Kubernetes and OpenShift",
      "executableArgs": [
        "--ozone-platform-hint=auto"
      ],
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "../engine/bin/leme",
          "to": "engine/leme"
        }
      ]
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "appImage": {
      "artifactName": "leme-${version}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "executableName": "Leme",
      "artifactName": "leme-setup-${version}.${ext}",
      "extraResources": [
        {
          "from": "../engine/bin/leme.exe",
          "to": "engine/leme.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Leme",
      "license": "../LICENSE"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "leme-${version}-${arch}.${ext}",
      "extraResources": [
        {
          "from": "../engine/bin/leme",
          "to": "engine/leme"
        }
      ]
    }
  },
  "desktopName": "leme.desktop"
}
