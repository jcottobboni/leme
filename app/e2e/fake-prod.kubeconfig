# Fake context to test the PROD badge. It points to a closed port and is never connected.
apiVersion: v1
kind: Config
clusters:
- name: fake-prd-cluster
  cluster: {server: "https://127.0.0.1:1"}
users:
- name: fake-user
  user: {token: "not-a-real-token"}
contexts:
- name: fake-app-prd/api-ocp-prd-example:6443/someone
  context: {cluster: fake-prd-cluster, user: fake-user, namespace: app}
