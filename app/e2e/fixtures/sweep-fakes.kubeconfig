# Fake contexts for the UI sweep (scripts/ui-sweep.mjs) and for screenshots: OpenShift-style names,
# several environments and two contexts with the same name on different clusters.
# Servers use the TEST-NET-1 range (192.0.2.0/24, RFC 5737), which is never routed; none is ever connected.
apiVersion: v1
kind: Config
clusters:
- name: ocp-c01
  cluster: {server: "https://192.0.2.1:6443"}
- name: ocp-c02
  cluster: {server: "https://192.0.2.2:6443"}
- name: ocp-dev
  cluster: {server: "https://192.0.2.3:6443"}
- name: oke-prd
  cluster: {server: "https://192.0.2.4:6443"}
users:
- name: fake-user
  user: {token: "not-a-real-token"}
contexts:
- name: payroll-api-prd/api-ocp-c01-acme-dc1:6443/alice
  context: {cluster: ocp-c01, user: fake-user, namespace: payroll-api-prd}
- name: payroll-api-prd/api-ocp-c02-acme-dc2:6443/alice
  context: {cluster: ocp-c02, user: fake-user, namespace: payroll-api-prd}
- name: payroll-web-stag/api-ocp-prd-acme-dc1:6443/alice
  context: {cluster: ocp-c01, user: fake-user, namespace: payroll-web-stag}
- name: billing-hml/api-ocp-c01-acme-dc1:6443/alice
  context: {cluster: ocp-c01, user: fake-user, namespace: billing-hml}
- name: payroll-dsv/api-ocp-dev-acme:6443/alice
  context: {cluster: ocp-dev, user: fake-user, namespace: payroll-dsv}
- name: oke-platform-prd
  context: {cluster: oke-prd, user: fake-user, namespace: platform}
